# Database Connection (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres.[REF]:***@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:***@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Storage (Asset & Media Hosting)
# SUPABASE_URL is what the server uses (assetsUploader, image remotePatterns).
# NEXT_PUBLIC_SUPABASE_URL is the browser-visible equivalent; set both to the same value.
SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_STORAGE_BUCKET="bucket_portofolio"

# Legacy asset host — only needed when Supabase Storage is not configured
ASSETS_UPLOAD_URL=""
ASSETS_BEARER_TOKEN=""

# Admin CMS Access Password
# Required. The app fails closed (all admin auth denied) when this is unset.
PAGE_ACCESS_PASSWORD="your_admin_password"
