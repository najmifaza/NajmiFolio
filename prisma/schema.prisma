generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String               @id @default("default")
  avatar       String
  email        String
  location     String
  languages    Json
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  certificates Certificate[]
  experiences  Experience[]
  translations ProfileTranslation[]
  skills       SkillGroup[]
  socialLinks  SocialLink[]
  studies      Study[]
}

model ProfileTranslation {
  id         String  @id @default(cuid())
  profileId  String
  locale     String
  name       String
  role       String
  headline   String
  subline    String
  intro      String
  aboutTitle String?
  aboutDesc  String?
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([locale])
}

model SocialLink {
  id        String  @id @default(cuid())
  profileId String
  name      String
  icon      String
  link      String
  essential Boolean @default(true)
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id           String                  @id @default(cuid())
  profileId    String
  company      String
  timeframe    String
  order        Int                     @default(0)
  images       Json?
  profile      Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations ExperienceTranslation[]
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  experienceId String
  locale       String
  role         String
  achievements Json
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
}

model Study {
  id           String             @id @default(cuid())
  profileId    String
  institution  String
  timeframe    String
  order        Int                @default(0)
  images       Json?
  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations StudyTranslation[]
}

model StudyTranslation {
  id          String @id @default(cuid())
  studyId     String
  locale      String
  degree      String
  description String
  study       Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, locale])
}

model SkillGroup {
  id           String                  @id @default(cuid())
  profileId    String
  title        String
  order        Int                     @default(0)
  skills       Json
  profile      Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  translations SkillGroupTranslation[]
}

model SkillGroupTranslation {
  id           String     @id @default(cuid())
  skillGroupId String
  locale       String
  title        String
  description  String?
  skillGroup   SkillGroup @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)

  @@unique([skillGroupId, locale])
}

model Certificate {
  id        String  @id @default(cuid())
  profileId String
  title     String
  issuer    String
  date      String
  image     String
  url       String?
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id           String               @id @default(cuid())
  slug         String               @unique
  link         String?
  github       String?
  featured     Boolean              @default(false)
  order        Int                  @default(0)
  images       Json
  publishedAt  DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]
}

model ProjectTranslation {
  id        String  @id @default(cuid())
  projectId String
  locale    String
  title     String
  summary   String
  content   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model MessageRoom {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String?
  openAt      DateTime?
  closeAt     DateTime?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    AnonymousMessage[]
}

model AnonymousMessage {
  id        String      @id @default(cuid())
  roomId    String
  content   String
  senderTag String?
  createdAt DateTime    @default(now())
  room      MessageRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([createdAt])
}
